digraph ocr_pipeline {
  graph [rankdir=TB, newrank=true, bgcolor="transparent", pad="0.2", nodesep="0.35", ranksep="0.48"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, color="#353535", fillcolor="#fffdf8", margin="0.10,0.07"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#666666", arrowsize=0.7];

  photo [label="Photograph"];
  geometry [label="Locate page + grids\nPerspective correction"];
  topology [label="Grid size + topology\nCell crops"];
  whole [label="Whole-number classifier\nPublisher canon"];
  samepage [label="Same-page reference\ndigit evidence"];
  fallback [label="Selective fallback\nReference + Tesseract"];
  specialist [label="Ambiguity specialists\nfamily · arity · quadrant", fillcolor="#fff0eb", color="#c83327"];
  clue [label="Reference-clue OCR\nblank-ink guard"];
  confidence [label="Confidence fusion\n(no silent rewrite)", shape=diamond, fillcolor="#f4f1e8"];
  hil [label="Human review\noriginal crops", fillcolor="#fff0eb", color="#c83327"];
  board [label="Approved playable board", fillcolor="#edf6ee", color="#287a3d"];
  play [label="Play immediately"];
  solver [label="Solver on hint/reveal\nuses player entries"];
  lexical [label="Guarded crossing-word\nevidence (planned)", style="rounded,dashed,filled", fillcolor="#ffffff"];

  { rank=same; photo; geometry; topology; }
  { rank=same; whole; samepage; clue; }
  { rank=same; fallback; confidence; specialist; }
  { rank=same; hil; board; }
  { rank=same; play; solver; lexical; }

  photo -> geometry -> topology;
  topology -> whole;
  topology -> samepage;
  topology -> clue;
  whole -> confidence;
  samepage -> confidence;
  whole -> fallback [label="untrusted only"];
  fallback -> confidence;
  confidence -> specialist [label="known family"];
  specialist -> confidence [label="veto / margin"];
  clue -> hil;
  confidence -> hil [label="uncertain"];
  confidence -> board [label="trusted"];
  hil -> board [label="confirmed"];
  board -> play;
  play -> solver [label="hint / reveal"];
  solver -> lexical [style=dashed];
  lexical -> hil [style=dashed, label="close family only"];
}
