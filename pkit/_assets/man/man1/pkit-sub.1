.TH PKIT-SUB 1 "April 2026" "pkit 0.1.0" "General Commands Manual"

.SH NAME
\fBpkit-sub\fR \- Minimal kitchen sink demonstrating core Click patterns.

.SH SYNOPSIS
.B pkit sub
[\fB-d\fR | \fB--dry-run\fR] [\fB--path\fR \fIpath\fR]
         [\fB-n\fR \fIname\fR | \fB--name\fR \fIname\fR]
         [\fB-l\fR | \fB--list\fR]
         [\fB-p\fR \fItext\fR | \fB--pattern\fR \fItext\fR] [\fB--luck\fR]
         [\fB--mode\fR \fIsubmode\fR]
         [\fB-v\fR \fIverbose\fR | \fB--verbose\fR \fIverbose\fR]
         [\fB--output\fR \fIoutput\fR]
         [\fIARGS\fR...]

.SH DESCRIPTION
{{ code.subcmd.description }}

.SH OPTIONS
.TP
.B -d, --dry-run
No mutations.

.TP
.B --path \fIpath\fR
O'er there.

.TP
.B -n, --name \fIname\fR
A rose by any other name.

.TP
.B -l, --list
A list.

.TP
.B -p, --pattern \fItext\fR
Pattern like a regex or glob.

.TP
.B --luck, --no-luck
No, no. (default: \fIfalse\fR)

.TP
.B --mode \fIsubmode\fR
Modality

.TP
.B -v, --verbose \fIverbose\fR
Engage gabby gossip.

.TP
.B --output \fIoutput\fR
Output format.

